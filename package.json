{
  "name": "vivid-asset-schema",
  "version": "1.0.0",
  "description": "ASSET.md schema and validator for VividGovTech asset repos.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "validate-asset": "bin/validate-asset.mjs"
  },
  "exports": {
    ".": "./lib/asset.mjs",
    "./schema": "./schema/asset.schema.json"
  },
  "files": [
    "bin",
    "lib",
    "schema",
    "templates"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  }
}
